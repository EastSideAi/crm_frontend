.vercel

# env & local
.env
.env.*
*.local

# скриншоты и черновики агента
.tmp/

# logs & OS
*.log
.DS_Store
Thumbs.db

# dev throwaway scripts и превью-харнессы: в них попадают внутренние цифры,
# а корень репозитория выкладывается на сайт как есть
/_*.mjs
/_*.js
/_*.html
/_*.py
shot.js

# черновики, скриншоты и локальные оболочки для проверки — репозиторий публичный,
# случайный `git add` не должен уносить сюда ключи из локального стенда
.env*

# рабочая память команды и служебные папки агента — не для публичной статики
memory.md
.agents/

# файлы для оператора: скриншоты и черновики, которые Павел забирает из панели
# песочницы. В гит не идут и на сайт не выкладываются — это рабочая передача,
# а не содержимое продукта.
files/

# Материалы ведомости, которым не место в git:
# finmodel-stage8.html — старое приложение ведомости, внутри живой anon-ключ Supabase;
# chat/ — сырая переписка, из которой собран _specs/finmodel/README.md.
_specs/finmodel/finmodel-stage8.html
_specs/finmodel/chat/
